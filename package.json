{
  "name": "srcpack",
  "version": "0.3.0",
  "description": "Zero-config CLI for bundling code into LLM-optimized context files",
  "keywords": [
    "llm",
    "ai",
    "context",
    "chatgpt",
    "claude",
    "gemini",
    "grok",
    "copilot",
    "code-bundler",
    "concatenate",
    "codebase",
    "source-code",
    "monorepo",
    "prompt",
    "context-window",
    "rag",
    "embedding",
    "ai-tools",
    "ai-coding",
    "agentic",
    "glob",
    "cli",
    "bun"
  ],
  "author": "Konstantin Tarkus <koistya@kriasoft.com>",
  "license": "MIT",
  "homepage": "https://kriasoft.com/srcpack/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kriasoft/srcpack.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/kriasoft/srcpack/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "srcpack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts ./src/index.ts --outdir ./dist --target node && tsc",
    "check": "tsc -p tsconfig.check.json",
    "test": "bun test tests/unit/ tests/e2e/",
    "test:unit": "bun test tests/unit/",
    "test:e2e": "bun test tests/e2e/",
    "test:login": "bun test --env-file .env.local tests/manual/login.test.ts",
    "test:upload": "bun test --env-file .env.local tests/manual/upload.test.ts",
    "test:all": "bun test --env-file .env.local tests/",
    "test:watch": "bun test tests/unit/ tests/e2e/ --watch",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@googleapis/drive": "^21.0.0",
    "cosmiconfig": "^10.0.0",
    "fast-glob": "^3.3.3",
    "google-auth-library": "10.5.0",
    "ignore": "^7.0.6",
    "oauth-callback": "^2.2.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/picomatch": "^4.0.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-llms": "^1.13.5"
  }
}
